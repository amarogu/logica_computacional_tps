      "id": "bkHC",
      "code_hash": "d42b461bbd4f98ac5848ca7015dca45a",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"estruturas\">Estruturas</h2>\n<table>\n<thead>\n<tr>\n<th>Classe</th>\n<th>Para que serve</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>box</code></td>\n<td>Grupo gen\u00e9rico de c\u00e9lulas: guarda <code>(linha, coluna) -&gt; valor</code> (<code>None</code> = livre)</td>\n</tr>\n<tr>\n<td><code>cube(n, i, j)</code></td>\n<td>Bloco <marimo-tex class=\"arithmatex\">||(n \\times n||)</marimo-tex> na posi\u00e7\u00e3o <marimo-tex class=\"arithmatex\">||((i, j)||)</marimo-tex></td>\n</tr>\n<tr>\n<td><code>path(n, start, end)</code></td>\n<td>Trecho reto de c\u00e9lulas (usado para linhas e colunas)</td>\n</tr>\n<tr>\n<td><code>XSudoku(n)</code></td>\n<td>Extens\u00e3o: as duas diagonais como grupos</td>\n</tr>\n<tr>\n<td><code>pistas_aleatorias(n, k)</code></td>\n<td><code>box</code> com <marimo-tex class=\"arithmatex\">||(k||)</marimo-tex> pistas em c\u00e9lulas distintas</td>\n</tr>\n<tr>\n<td><code>Modelo(n)</code></td>\n<td>Uma vari\u00e1vel por c\u00e9lula, restri\u00e7\u00f5es e <code>resolver()</code></td>\n</tr>\n</tbody>\n</table></span>"
          }
        }
      ],
      "console": []
