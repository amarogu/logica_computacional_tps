        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"r1-box-grupo-generico-de-celulas\">R1 \u2014 <code>box</code>: grupo gen\u00e9rico de c\u00e9lulas</h2></span>"
          }
        }
      ],
      "console": []
    },
