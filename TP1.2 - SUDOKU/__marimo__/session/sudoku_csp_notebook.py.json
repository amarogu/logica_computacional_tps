            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"r2-e-r3-cube-bloco-e-path-troco-reto\">R2 e R3 \u2014 <code>cube</code> (bloco) e <code>path</code> (tro\u00e7o reto)</h2></span>"
          }
